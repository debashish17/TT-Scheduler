# ─────────────────────────────────────────────────────────
# Frontend Environment Variables — copy to .env and fill in
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend API ───────────────────────────────────────────
# Local development:
VITE_API_URL=http://localhost:8000
# Production (set to your Render service URL):
# VITE_API_URL=https://tt-scheduler-backend.onrender.com

# ── WebSocket ─────────────────────────────────────────────
# Local development:
VITE_WS_URL=ws://localhost:8000
# Production (set to your Render service URL with wss://):
# VITE_WS_URL=wss://tt-scheduler-backend.onrender.com

# ── App ───────────────────────────────────────────────────
VITE_APP_NAME=TT-Scheduler
VITE_APP_VERSION=1.0.0

# ── Feature Flags ─────────────────────────────────────────
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true