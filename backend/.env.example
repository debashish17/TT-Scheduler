# ─────────────────────────────────────────────────────────
# Backend Environment Variables — copy to .env and fill in
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Database (Supabase pooler connection string) ──────────
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Application ───────────────────────────────────────────
PROJECT_NAME=Timetable Scheduler
VERSION=1.0.0
API_V1_STR=/api/v1
# development | production
ENVIRONMENT=development

# ── Security ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────
# Add your Vercel frontend URL here (JSON array string)
# Production example:
#   BACKEND_CORS_ORIGINS=["https://tt-scheduler.vercel.app","http://localhost:5173"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Frontend URL (used in email links etc.) ───────────────
# Local:
FRONTEND_URL=http://localhost:5173
# Production (Vercel):
# FRONTEND_URL=https://tt-scheduler.vercel.app

# ── Celery / Redis ────────────────────────────────────────
# Leave blank to disable Celery (Render free tier / local without Redis)
# Local with Redis:
#   CELERY_BROKER_URL=redis://localhost:6379/0
#   CELERY_RESULT_BACKEND=redis://localhost:6379/0
#   REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_URL=

# ── Email (optional) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── AI Draft (optional) ────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# Leave blank to disable the AI Draft feature on the dashboard
OPENAI_API_KEY=
